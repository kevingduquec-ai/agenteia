NODE_ENV=development

DATABASE_URL=postgresql://prefiero:prefiero@localhost:5433/prefiero_ia
REDIS_URL=redis://localhost:6379

# Usadas SOLO por docker-compose.prod.yml (ver docs/DEPLOYMENT.md) — en
# desarrollo local (docker-compose.yml) la contraseña de Postgres queda
# fija en "prefiero" y no aplica NEXT_PUBLIC_API_URL de aqui.
POSTGRES_PASSWORD=
# Dominio PUBLICO de la API (con https://), ej: https://api.tu-dominio.com
# Se hornea en el bundle de apps/web en build time — cambiarlo requiere
# reconstruir la imagen de "web", no solo reiniciar el contenedor.
NEXT_PUBLIC_API_URL=

# QwenCloud tiene DOS sistemas de facturacion totalmente separados que NO
# se pueden mezclar — cada uno con su propia API key y Base URL:
#
#   Pay-as-you-go: key "sk-ws-...", Base URL por workspace
#     (https://ws-xxxxxxxxxxxx.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1)
#   Token Plan (prepago): key "sk-sp-..." generada desde la consola de
#     Token Plan (no la de "API Keys" normal), Base URL fijo:
#     https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
#
# Si compraste un Token Plan, usa la key "sk-sp-" con ESE Base URL — una
# key "sk-ws-" con el Base URL de Token Plan (o viceversa) da 401/403
# aunque el plan este activo y pago. Ver docs.qwencloud.com/token-plan.
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-flash
QWEN_BASE_URL=

# Los embeddings SIEMPRE son pay-as-you-go (el Token Plan no los cubre, ni
# aunque QWEN_BASE_URL de arriba sea el de Token Plan) — si QWEN_BASE_URL
# es un dominio de Token Plan, estas dos son obligatorias con la key/URL
# de workspace normal. Si todo tu uso es pay-as-you-go, puedes dejarlas
# vacias: caen de vuelta a QWEN_API_KEY/QWEN_BASE_URL.
QWEN_EMBEDDING_API_KEY=
QWEN_EMBEDDING_BASE_URL=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

LLM_PRIMARY=qwen
LLM_FALLBACK=deepseek

EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=qwen3.7-text-embedding

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

JWT_SECRET=

# Panel de administracion (/admin en apps/web) — sección 41-46: dashboard
# para el dueño del marketplace + bandeja de soporte humano. Un solo
# "owner" GLOBAL fijo (bootstrap) — superadmin de la plataforma, puede
# operar sobre cualquier tenant/cliente. Crea cuentas "admin" (ve todo) y
# "soporte" (SOLO bandeja de soporte, nunca dashboards) DENTRO de un
# tenant especifico desde /admin/users — esas ya no son variables de
# entorno, viven en la tabla `admin_users` (con su propio `tenant_id`). La
# contraseña del owner NUNCA va en texto plano — genera el hash bcrypt con:
# cd apps/api && node -e "console.log(require('bcryptjs').hashSync('TU_PASSWORD', 10))"
OWNER_USERNAME=admin
OWNER_PASSWORD_HASH=

# Arquitectura multi-tenant (pedido explicito del usuario: una sola
# instalacion debe poder atender a mas de un cliente, distinguiendo cual
# es cual por la URL) — cada cliente es una fila en la tabla `tenants`
# (slug, host publico, crawler_base_url, cupos de admin/soporte). Ya NO
# existen variables globales CRAWLER_BASE_URL/MAX_ADMIN_SEATS/
# MAX_SUPPORT_SEATS: eso vive por tenant en la base. Crear un cliente
# nuevo: `pnpm run create-tenant -- --slug=... --name=... --host=... --crawler-base-url=...`
# (ver docs/DEPLOYMENT.md).
#
# DEFAULT_TENANT_SLUG es solo para desarrollo local: cuando una peticion
# llega por "localhost" a secas (sin el header X-Tenant-Host real que
# manda apps/web segun el subdominio del navegador), se usa este tenant.
# Si en tu base solo existe un tenant, ni siquiera hace falta fijarlo —
# se usa automaticamente.
DEFAULT_TENANT_SLUG=prefiero-acr

CRAWLER_DELAY_MS=800

API_PORT=3001
WEB_PORT=3000

# Origenes CORS adicionales (separados por coma) que no pertenecen a
# ningun tenant especifico — ej. herramientas internas. Los dominios de
# cada tenant (su `host` y su `extra_cors_origins`) ya se permiten
# automaticamente, sin necesidad de listarlos aqui.
CORS_ORIGINS=
